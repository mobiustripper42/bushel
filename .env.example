# Copy to .env.local and fill in. Never commit .env.local.

# Data layer (pg / Neon). Falls back to the local docker service if unset.
DATABASE_URL=postgres://bushel:bushel@localhost:5433/bushel_dev

# Admin auth (DEC-047). SESSION_SECRET signs the HMAC session cookie — required
# in production (fails fast if unset); `openssl rand -hex 32`. RESEND_* send the
# login-code email (throw at send time if unset).
SESSION_SECRET=
RESEND_API_KEY=
RESEND_FROM=Bay Branch Farm <auth@example.com>

# Supabase (auth-only, vestigial until 10.5)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Testing
PLAYWRIGHT_BASE_URL=http://localhost:3001
NOTIFICATIONS_ENABLED=false
